hown"	| shown |	shown := windows reverse		         detect: [ :each | each handlesEvents ]		         ifNone: [ windows ifEmpty: [ nil ] ifNotEmpty: [ windows last ] ].	shown == window ifTrue: [ ^ self ].	window := shown.	window ifNotNil: [ window open ]! !!OSWebDriver methodsFor: 'system startup'!shutDown: quitting	self stopEventLoop! !!OSWebDriver methodsFor: 'events'!startEventLoop	self stopEventLoop.	interruptSemaphore consumeAllSignals.	self primSetInputSemaphore:		(Smalltalk registerExternalObject: inputSemaphore).	self primSetInterruptSemaphore:		(Smalltalk registerExternalObject: interruptSemaphore).	eventProcess := [ self eventLoop ]		                forkAt: Processor lowIOPriority		                named: 'Web event loop'.	interruptProcess := [ self interruptLoop ]		                    forkAt: Processor userInterruptPriority		                    named: 'Web interrupt watcher'! !!OSWebDriver methodsFor: 'system startup'!startUp: resuming	self startEventLoop! !!OSWebDriver methodsFor: 'events'!stopEventLoop	"Never terminate the active process: an event may have started the shutdown"	{		eventProcess.		interruptProcess } do: [ :process |		(process isNil or: [ process == Processor activeProcess ]) ifFalse: [			process terminate ] ].	eventProcess := interruptProcess := nil.	self		primSetInputSemaphore: 0;		primSetInterruptSemaphore: 0.	Smalltalk		unregisterExternalObject: inputSemaphore;		unregisterExternalObject: interruptSemaphore! !!OSWebDriver methodsFor: 'window creation'!unregisterWindowWithId: aWindowId	"Pharo 15 takes the current driver for an OSSDL2Driver when it finalizes a window of SDL (SDL_Window class>>#finalizeResourceData:), as after a restart of the world renderer on another driver (see #registerWindow:): it is not mine"! !!OSWebDriver methodsFor: 'accessing'!window	"The window that the page shows, and that gets its input"	^ window! !!OSWebDriver methodsFor: 'window creation'!windowDestroyed: aBackendWindow	windows remove: aBackendWindow ifAbsent: [ ^ self ].	self showWindow! !!OSWebDriver methodsFor: 'accessing'!windows	"My windows, the oldest first"	^ windows! !!OSWebDriver class methodsFor: 'image setup'!hasFreeType	"Whether the VM finds FreeType, by the name the image gives it on Linux (FT2FFILibrary>>#unixLibraryName), which the web VMs register their own FreeType under. A web VM built without FreeType or without the FFI, or with FreeType hidden (PHARO_WASM_FFI_HIDE=freetype), fails the lookup"	^ [	  (ExternalAddress		   loadSymbol: 'FT_Init_FreeType'		   module: 'libfreetype.so.6')		  ifNil: [ false ]		  ifNotNil: [ :address | address isNull not ] ]		  on: Error		  do: [ :error | error return: false ]! !!OSWebDriver class methodsFor: 'class initialization'!initialize	"Take part in the session startup (see #startUp:), before the world opens: Pharo 12 opens it at the end of the startup list (ErrorHandlerSessionHandler), but Pharo 15 at the default priority of the System category (UIManager class>>#startUp:), so take a priority before it, that of FileLocator. Loading the package again does not register me twice: a registration replaces the one of the same name. (Pharo 15 refuses to unregister a class that is not registered)"	SessionManager default registerSystemClassNamed: self name atPriority: 90! !!OSWebDriver class methodsFor: 'testing'!isSuitable	^ self primIsAvailable! !!OSWebDriver class methodsFor: 'testing'!isSupported	^ self primIsAvailable! !!OSWebDriver class methodsFor: 'versions'!packageMarker	"A symbol of its own for each #packageVersion, which the image keeps as a literal of this method: the worker of the page finds the version of an image in its bytes without booting it. It is the name of the package and the version"	^ #OSWindowWebPackage5! !!OSWebDriver class methodsFor: 'versions'!packageVersion	"The version of this package: web-bootstrap.st files the package in again over an older one, and the page sets an image of an older version up again (see #setUpImage). Version 1 had neither this method nor #setUpImage, and bitmap fonts; 2 keeps the FreeType fonts of the stock image when the VM has FreeType; 3 draws Athens with cairo without the SurfacePlugin, which the web VMs lack (the AthensCairoSurface extension of this package); 4 gives Iceberg https:// remotes (#setUpGit); 5 draws the world in device pixels on high-density displays (OSWebFormRenderer>>#outputExtent). Change #packageMarker with it. packaging/emscripten/tools/stage.mjs reads both from this file, for the manifest of the page"	^ 5! !!OSWebDriver class methodsFor: 'primitives'!primIsAvailable	"Answer whether the page provides a display. Only the world page does"	<primitive: #primitiveWebDisplayIsAvailable module: #WebDisplayPlugin>	^ false! !!OSWebDriver class methodsFor: 'image setup'!setUpBitmapFonts	"The bitmap fonts of the image, for a VM without FreeType"	FreeTypeSystemSettings loadFt2Library: false.	StandardFonts setSmallBitmapFonts! !!OSWebDriver class methodsFor: 'image setup'!setUpFonts	"FreeType fonts when the VM that runs the image has FreeType, else bitmap fonts. prepare-web-image.st runs me at build time on a native VM, whose FreeType does not matter: the build tells in PHARO_WEB_FONTS, freetype or bitmap, which fonts its web VM can draw (cmake/emscripten/webimage.cmake). Without that variable, as in the page, ask the VM (#hasFreeType)"	| fonts |	fonts := OSEnvironment current at: 'PHARO_WEB_FONTS' ifAbsent: [ '' ].	fonts ifEmpty: [		fonts := self hasFreeType			         ifTrue: [ 'freetype' ]			         ifFalse: [ 'bitmap' ] ].	fonts = 'freetype' ifTrue: [ ^ self setUpFreeTypeFonts ].	fonts = 'bitmap' ifTrue: [ ^ self setUpBitmapFonts ].	self error: 'PHARO_WEB_FONTS is ' , fonts printString , ', neither freetype nor bitmap'! !!OSWebDriver class methodsFor: 'image setup'!setUpFreeTypeFonts	"The fonts of the stock Pharo 12 and Pharo 15 images, which they embed, drawn by FreeType. An image of version 1 of this package has bitmap fonts instead, which turning FreeType on again does not change: so set each standard font, as the stock images have it"	| sans code |	FreeTypeSystemSettings loadFt2Library: true.	sans := 'Source Sans Pro'.	code := 'Source Code Pro'.	StandardFonts		defaultFont: (LogicalFont familyName: sans pointSize: 10);		codeFont: (LogicalFont familyName: code pointSize: 10);		listFont: (LogicalFont familyName: sans pointSize: 10);		menuFont: (LogicalFont familyName: sans pointSize: 10);		buttonFont: (LogicalFont familyName: sans pointSize: 10);		windowTitleFont: (LogicalFont familyName: sans pointSize: 11);		balloonFont: (LogicalFont familyName: sans pointSize: 9);		haloFont: (LogicalFont familyName: sans pointSize: 9)! !!OSWebDriver class methodsFor: 'image setup'!setUpGit	"Iceberg makes the remote of a github:// repository an SSH one (#scpUrl) by default, which no web VM can reach: they have no libssh2, and a browser opens no socket. An https:// remote goes through the smart-HTTP transport of a web VM built with libgit2 (WASM_LIBGIT2), behind the CORS proxy of the Console's Settings. Set it whatever the VM, also at build time on a native VM, whose libgit2 does not tell what the web VM has: nothing else works in a browser. An image without Iceberg is left alone"	(Smalltalk hasClassNamed: #Iceberg) ifFalse: [ ^ self ].	(Smalltalk at: #Iceberg) remoteTypeSelector: #httpsUrl! !!OSWebDriver class methodsFor: 'image setup'!setUpImage	"Set the image up for the web VMs: prepare-web-image.st calls me at build time, and web-bootstrap.st in the page. Both call nothing else of the kind, so that a new version of this package changes only me"	self		setUpFonts;		setUpGit! !!OSWebDriver class methodsFor: 'system startup'!shutDown: quitting	"OSWindowDriver is registered too, and shuts the current driver down"! !!OSWebDriver class methodsFor: 'system startup'!startUp: isImageStarting	"I run in the System startup list, before the world opens (see #initialize). The image may have saved another driver class (the stock image saves OSSDL2Driver), so take over whenever the page provides a display. An image saved in the page keeps me as its driver class, so give the choice back when it starts elsewhere"	isImageStarting ifFalse: [ ^ self ].	self isSuitable ifFalse: [		DriverClass == self ifTrue: [ DriverClass := nil ].		^ self ].	DriverClass := self.	Current := nil! !!OSWebFormRenderer methodsFor: 'initialization'!initialize	super initialize.	blits := 0.	blitPixels := 0.	presents := 0! !!OSWebFormRenderer methodsFor: 'accessing'!outputExtent	"The canvas in device pixels: OSWorldRenderer divides it by the window extent, the canvas in CSS pixels, for its canvasScaleFactor, which is then devicePixelRatio. The Form extent would not do: after the page shrinks the canvas to less than half, the old Form would ask for twice the scale"	^ backendWindow pixelExtent! !!OSWebFormRenderer methodsFor: 'primitives'!primBlit: bits width: width height: height depth: depth left: left top: top right: right bottom: bottom	"Copy the rows top to bottom - 1 and the columns left to right - 1 of the 32-bit Form bits into the frame of the page"	<primitive: #primitiveWebBlit module: #WebDisplayPlugin>	blits := blits + 1.	blitPixels := blitPixels + (right - left * (bottom - top))! !!OSWebFormRenderer methodsFor: 'primitives'!primPresent	<primitive: #primitiveWebPresent module: #WebDisplayPlugin>	presents := presents + 1! !!OSWebFormRenderer methodsFor: 'accessing'!stats	"Answer the blits, the blitted pixels and the presents that fell back to Smalltalk"	^ {		  blits.		  blitPixels.		  presents }! !!OSWebFormRenderer methodsFor: 'updating screen'!updateAll	form ifNil: [ ^ self ].	self updateAreas: { form boundingBox } immediate: true! !!OSWebFormRenderer methodsFor: 'morphic integration'!updateAreas: allDamage immediate: forceToScreen	| damaged |	form ifNil: [ ^ self ].	(backendWindow isNil or: [ backendWindow isShown ]) ifFalse: [ ^ self ].	damaged := false.	allDamage do: [ :rectangle |		(self updateRectangle: rectangle) ifTrue: [ damaged := true ] ].	damaged ifTrue: [ self primPresent ]! !!OSWebFormRenderer methodsFor: 'updating screen'!updateRectangle: aRectangle	"Blit the part of aRectangle inside the Form, widened to whole pixels. Answer whether there was one"	| area |	form ifNil: [ ^ false ].	area := aRectangle intersect: form boundingBox ifNone: [ ^ false ].	area := area origin floor corner: area corner ceiling.	area hasPositiveExtent ifFalse: [ ^ false ].	self		primBlit: form bits		width: form width		height: form height		depth: form depth		left: area left		top: area top		right: area right		bottom: area bottom.	^ true! !OSWebDriver initialize!