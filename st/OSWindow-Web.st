ing'!handleMouseButtonRelease: anEvent	self updatePosition: anEvent.	self deliver: ((OSMouseButtonReleaseEvent for: osWindow)			 button: (anEvent at: 5);			 position: lastPosition;			 yourself)! !!OSWebBackendWindow methodsFor: 'event handling'!handleMouseMove: anEvent	| previous |	previous := lastPosition.	self updatePosition: anEvent.	self deliver: ((OSMouseMoveEvent for: osWindow)			 position: lastPosition;			 delta: lastPosition - previous;			 yourself)! !!OSWebBackendWindow methodsFor: 'event handling'!handleMouseWheel: anEvent	"The page sends whole notches, positive away from the user as in SDL"	self updatePosition: anEvent.	self deliver: ((OSMouseWheelEvent for: osWindow)			 position: lastPosition;			 scrollHorizontal: (anEvent at: 7);			 scrollVertical: (anEvent at: 8);			 yourself)! !!OSWebBackendWindow methodsFor: 'event handling'!handleResize: anEvent	"The page may hide or collapse the canvas. Keep one pixel at least, as #extent does"	| extent |	extent := ((anEvent at: 5) max: 1) @ ((anEvent at: 7) max: 1).	attributes extent: extent.	self deliver: ((OSWindowResizeEvent for: osWindow)			 width: extent x;			 height: extent y;			 yourself)! !!OSWebBackendWindow methodsFor: 'event handling'!handleTextInput: anEvent	"Text input carries no modifiers, as with OSSDL2BackendWindow: Morphic drops the text typed with Alt, Ctrl or Cmd held, and Option or AltGr type characters such as @ and [ on many layouts"	^ ((OSTextInputEvent for: osWindow)		   text: (String with: (Character value: (anEvent at: 7)));		   position: lastPosition;		   yourself) deliver! !!OSWebBackendWindow methodsFor: 'event handling'!handleWebEvent: anEvent	"Deliver anEvent, a record of 8 integers from the page (see OSWebDriver)"	| handler |	handler := #( #handleMouseMove: #handleMouseButtonPress:	              #handleMouseButtonRelease: #handleMouseWheel:	              #handleKeyDown: #handleKeyUp: #handleTextInput:	              #handleResize: #handleFocus: #handleClose: )		           at: (anEvent at: 1)		           ifAbsent: [ ^ self ].	modifierState := (anEvent at: 6) bitAnd: 16rFF.	buttonState := (anEvent at: 6) bitShift: -8.	self perform: handler with: anEvent! !!OSWebBackendWindow methodsFor: 'testing'!handlesEvents	"Whether my OSWindow handles events, as the world and the Emergency Debugger do"	^ osWindow notNil and: [ osWindow eventHandler notNil ]! !!OSWebBackendWindow methodsFor: 'initialization'!initialize	super initialize.	lastPosition := 0 @ 0.	modifierState := 0.	buttonState := 0.	clipboardText := ''.	pastedText := #[  ]! !!OSWebBackendWindow methodsFor: 'testing'!isShown	"Whether the page shows me (see OSWebDriver)"	^ driver notNil and: [ driver window == self ]! !!OSWebBackendWindow methodsFor: 'factory'!newFormRenderer: aForm	^ renderer := OSWebFormRenderer new		              form: aForm;		              backendWindow: self;		              yourself! !!OSWebBackendWindow methodsFor: 'initialization'!open	"Ask the page to show its canvas, at the size the page reported, if it did (see OSWebDriver>>#afterMainPharoWindowCreated:), with my title. When I come back after another window, draw me whole again"	attributes extent: self extent.	self		primOpenCanvas: attributes extent		title: (attributes title ifNil: [ '' ]) asString utf8Encoded.	renderer ifNotNil: [ renderer updateAll ]! !!OSWebBackendWindow methodsFor: 'accessing'!pixelExtent	"The extent of the canvas in device pixels, devicePixelRatio times #extent. Natively, and before the page reports it, #extent stands in: one device pixel per CSS pixel"	^ (self primCanvasPixelExtent ifNil: [ ^ self extent ]) max: 1 @ 1! !!OSWebBackendWindow methodsFor: 'primitives'!primCanvasExtent	"Answer the extent of the page's canvas, or nil before the page reports one"	<primitive: #primitiveWebCanvasExtent module: #WebDisplayPlugin>	^ nil! !!OSWebBackendWindow methodsFor: 'primitives'!primCanvasPixelExtent	"Answer the extent of the page's canvas in device pixels, or nil before the page reports one"	<primitive: #primitiveWebCanvasPixelExtent module: #WebDisplayPlugin>	^ nil! !!OSWebBackendWindow methodsFor: 'primitives'!primClipboardText	"Answer the UTF-8 bytes last pasted into the page"	<primitive: #primitiveWebClipboardText module: #WebDisplayPlugin>	^ nil! !!OSWebBackendWindow methodsFor: 'primitives'!primFocus	<primitive: #primitiveWebFocus module: #WebDisplayPlugin>	^ nil! !!OSWebBackendWindow methodsFor: 'primitives'!primOpenCanvas: anExtent title: titleBytes	<primitive: #primitiveWebOpenCanvas module: #WebDisplayPlugin>	^ nil! !!OSWebBackendWindow methodsFor: 'primitives'!primSetClipboardText: bytes	<primitive: #primitiveWebSetClipboardText module: #WebDisplayPlugin>	^ nil! !!OSWebBackendWindow methodsFor: 'primitives'!primSetCursor: bits mask: maskBits extent: anExtent offset: anOffset	"bits and maskBits are the words of 1-bit Forms, and anOffset is the Form offset, the negated hot spot"	<primitive: #primitiveWebSetCursor module: #WebDisplayPlugin>	^ nil! !!OSWebBackendWindow methodsFor: 'primitives'!primSetTitle: bytes	<primitive: #primitiveWebSetTitle module: #WebDisplayPlugin>	^ nil! !!OSWebBackendWindow methodsFor: 'accessing'!raise	"OSWorldRenderer>>#doActivate focuses the window, which raises it: move the keyboard focus to the canvas"	self isShown ifTrue: [ self primFocus ]! !!OSWebBackendWindow methodsFor: 'accessing'!screenScaleFactor	"The world has the size of the canvas in CSS pixels, and mouse positions are in CSS pixels. The pixels of high-density displays come from the canvasScaleFactor (see my class comment)"	^ 1! !!OSWebBackendWindow methodsFor: 'cursor'!setMouseCursor: cursor mask: mask andScale: scale	"The page turns the 1-bit Forms into a CSS cursor, whose pixels are CSS pixels as those of the world are"	| maskForm |	maskForm := mask ifNil: [ cursor ].	(cursor depth = 1 and: [		 maskForm depth = 1 and: [ maskForm extent = cursor extent ] ])		ifFalse: [ ^ self ].	cursor unhibernate.	maskForm unhibernate.	self		primSetCursor: cursor bits		mask: maskForm bits		extent: cursor extent		offset: cursor offset! !!OSWebBackendWindow methodsFor: 'accessing'!title: aString	"The page shows the title when it shows me, see #open"	attributes title: aString.	self isShown ifTrue: [ self primSetTitle: aString asString utf8Encoded ]! !!OSWebBackendWindow methodsFor: 'event handling'!updatePosition: anEvent	lastPosition := (anEvent at: 3) @ (anEvent at: 4)! !!OSWebDriver methodsFor: 'events'!afterMainPharoWindowCreated: anOSWindow	"OSWorldRenderer>>#doActivate opens the world at the extent it was saved with, but the page reported the size of its canvas before the image started: take that size now, before the world paints its first frame, which then fills the canvas"	| renderer |	renderer := self currentWorld worldState worldRenderer.	((renderer respondsTo: #window) and: [ renderer window == anOSWindow ])		ifTrue: [ renderer checkForNewScreenSize ]! !!OSWebDriver methodsFor: 'window creation'!createWindowWithAttributes: attributes osWindow: osWindow	| backend |	backend := OSWebBackendWindow fromAttributes: attributes for: osWindow.	backend		osWindow: osWindow;		driver: self.	windows addLast: backend.	self showWindow.	^ backend! !!OSWebDriver methodsFor: 'events'!eventLoop	"Drain the queue before waiting: the page may have pushed events while the image was not listening, for instance during a snapshot"	[	self processEvents.	inputSemaphore		wait;		consumeAllSignals ] repeat! !!OSWebDriver methodsFor: 'events'!handleEvent: anEvent	"anEvent is a record of 8 integers, see my class comment"	(anEvent at: 1) = 11 ifTrue: [ ^ self saveImage ].	(self isInterruptKey: anEvent) ifTrue: [ ^ self interruptUser ].	window ifNotNil: [ window handleWebEvent: anEvent ]! !!OSWebDriver methodsFor: 'initialization'!initialize	super initialize.	windows := OrderedCollection new.	inputSemaphore := Semaphore new.	interruptSemaphore := Semaphore new.	eventBuffer := IntegerArray new: 8.	pendingEvents := SharedQueue new! !!OSWebDriver methodsFor: 'events'!interruptLoop	"The page's Stop button calls vm_interrupt(), which signals interruptSemaphore through the WebHostPlugin"	[	interruptSemaphore wait.	self interruptUser ] repeat! !!OSWebDriver methodsFor: 'events'!interruptUser	"Interrupt the busy process, as the user interrupt key does on desktop VMs. UserInterruptHandler>>#processToInterrupt takes the first process ready to run below my priority, which can be another process of the priority of the UI, while the UI process runs a loop: no debugger can open then, since the UI process draws it. So interrupt the UI process when it is ready to run, that is, waits on no semaphore, and leave the other cases to UserInterruptHandler"	| ui |	ui := MorphicUIManager uiProcess.	(ui isNil or: [ (self isReadyToRun: ui) not ]) ifTrue: [		^ UserInterruptHandler new handleUserInterrupt ].	UserInterruptHandler cmdDotEnabled ifFalse: [ ^ self ].	[ ui debugWithTitle: 'User Interrupt' ]		on: Error		fork: [ :ex | ex pass ]! !!OSWebDriver methodsFor: 'testing'!isInterruptKey: anEvent	"Alt, Ctrl or Cmd with the period key, as SDL_KeyDownEvent>>#isUserInterrupt checks for OSSDL2Driver"	^ (anEvent at: 1) = 5 and: [		  (anEvent at: 5) = $. asInteger and: [			  (anEvent at: 6) anyMask: 2r1110 ] ]! !!OSWebDriver methodsFor: 'testing'!isReadyToRun: aProcess	"Whether aProcess is in a run queue of the Processor, rather than waiting on a semaphore (a Delay, say), suspended or terminated"	| list |	list := aProcess suspendingList.	^ list notNil and: [ (list isKindOf: Semaphore) not ]! !!OSWebDriver methodsFor: 'primitives'!primNextEventInto: anIntegerArray	"Copy the next page event into anIntegerArray (8 integers). Answer false when none is queued"	<primitive: #prim