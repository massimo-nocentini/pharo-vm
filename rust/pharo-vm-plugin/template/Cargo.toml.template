[package]
name = "my-pharo-plugin"
version = "0.1.0"
edition = "2021"

[lib]
# This name decides three things that must agree: the built file name
# (libMyPlugin.so), the module name the VM looks up, and the `module:` in your
# image-side pragma.
name = "MyPlugin"
crate-type = ["cdylib"]

[dependencies]
# The crate is not published yet, so point at your Pharo checkout. Once it is
# on crates.io this becomes `pharo-vm-plugin = "0.1"`.
pharo-vm-plugin = { path = "/path/to/pharo-vm/rust/pharo-vm-plugin" }

# Deliberately no `[profile.release] panic = "abort"` here.
#
# The SDK fences every primitive body in `catch_unwind`, which is what turns a
# panic into a clean primitive failure instead of a dead image. `panic =
# "abort"` makes that catch dead code -- the process is gone before it can run
# -- so it defeats the very guarantee it looks like it is reinforcing. Leave
# the default (unwind).
#
# Panics still never reach C: the catch is at the `extern "C"` boundary, and
# any of your own `extern "C"` entry points *outside* that fence keep aborting
# on unwind anyway, which rustc arranges for you.
