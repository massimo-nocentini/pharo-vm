+static gpointer
+attribute_copy_func (gconstpointer attribute,
+                     gpointer      data)
+{
+  return pango_attribute_copy (attribute);
+}
+
 /**
  * pango_attr_list_copy:
  * @list: (nullable): a `PangoAttrList`
@@ -1988,7 +1995,8 @@
   if (!list->attributes || list->attributes->len == 0)
     return new;
 
-  new->attributes = g_ptr_array_copy (list->attributes, (GCopyFunc)pango_attribute_copy, NULL);
+  /* (Pharo) a GCopyFunc takes two arguments: pango_attribute_copy, cast to one, traps in WebAssembly */
+  new->attributes = g_ptr_array_copy (list->attributes, attribute_copy_func, NULL);
 
   return new;
 }
