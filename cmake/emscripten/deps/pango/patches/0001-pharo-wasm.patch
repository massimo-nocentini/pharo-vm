+#ifdef __EMSCRIPTEN__
+/* Pharo's WebAssembly VM has no threads (g_thread_new fails): the work of
+ * the fontconfig thread is done synchronously, when it is queued. */
+static void
+fc_queue_push (GAsyncQueue *queue,
+               ThreadData  *td)
+{
+  switch (td->op)
+    {
+    case FC_INIT:
+      init_in_thread (td);
+      break;
+    case FC_MATCH:
+      match_in_thread (td);
+      break;
+    case FC_SORT:
+      sort_in_thread (td);
+      break;
+    case FC_END:
+    default:
+      thread_data_free (td);
+      break;
+    }
+}
+#define g_async_queue_push(queue, td) fc_queue_push ((queue), (td))
+#endif
