+/* (Pharo) GClosureNotify functions for one-argument destroy functions */
+typedef struct {
+  gpointer data;
+  GDestroyNotify destroy;
+} CancellableDestroyData;
+
+static void
+cancellable_destroy_data_notify (gpointer  data,
+                                 GClosure *closure)
+{
+  CancellableDestroyData *destroy = data;
